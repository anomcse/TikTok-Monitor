# Copie este arquivo para ".env" ao rodar localmente.
# Em produção (Render, Railway, etc.) NÃO envie um arquivo .env — configure
# estas mesmas chaves em "Environment Variables" no painel do serviço.
# Sem TIKTOK_SIGN_API_KEY e TIKTOK_SESSIONID, as conexões usam assinatura
# anônima do Euler Stream, que é fortemente limitada e tende a falhar ou
# nunca entregar eventos quando rodando em IP de datacenter (cloud hosts).

# Cookie "sessionid" da sua conta TikTok (recomendado — ver README).
TIKTOK_SESSIONID=

# Chave da Euler Stream (https://www.eulerstream.com) — necessária para
# conexões estáveis. Formato: euler_XXXXXXXX...
TIKTOK_SIGN_API_KEY=

# Datacenter alvo (opcional). Ver README para como obter.
TIKTOK_TT_TARGET_IDC=

# Host/porta do health server interno do bot (não confundir com o dashboard).
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8787

# Token para proteger as rotas administrativas do dashboard (pausar/retomar
# streamers, editar listas, etc). Defina algo forte em produção.
DASHBOARD_ADMIN_TOKEN=

# Em produção, o Render injeta PORT automaticamente — não defina manualmente
# a não ser que esteja rodando local e queira fixar uma porta para o
# dashboard (padrão local: 5177).
# PORT=5177
